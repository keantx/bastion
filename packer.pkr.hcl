# end of unused variables

source "azure-arm" "nonprod_(redacted)" {
  azure_tags = {
    CommitID    = "${var.commit_id}"
    Description = "Image deployment"
    Owner       = "Infra Team"
  }
  shared_image_gallery_destination  {
    gallery_name        = "(redacted)"
    image_name          = "${var.image_name}"
    image_version       = "${var.version}"
    replication_regions = split(",", "${var.regions}")
    resource_group      = "(redacted)"
    subscription        = "(redacted)"
  }
  build_resource_group_name           = "(redacted)"
  client_id                           = "${var.cl_id}"
  client_secret                       = "${var.cl_secret}"
  image_publisher                     = "Canonical"
  image_offer                         = "ubuntu-26_04-lts"
  image_sku                           = "server"
  image_version                       = "latest"
  os_type                             = "Linux"
  subscription_id                     = "(redacted)"
  tenant_id                           = "(redacted)"
  virtual_network_name                = "(redacted)"
  virtual_network_resource_group_name = "(redacted)"
  virtual_network_subnet_name         = "packer"
  vm_size                             = "Standard_DS2_v2"
  skip_create_image                   = "${var.skip_create_image}"
}

# a build block invokes sources and runs provisioning steps on them. The
# documentation for build blocks can be found here:
# https://www.packer.io/docs/templates/hcl_templates/blocks/build
build {
  sources = ["source.azure-arm.nonprod_(redacted)"]

  # copy data directory to the VM
  # (data dir were packed into data.tar.gz by the pipeline)
  provisioner "file" {
    source      = "${path.root}/data.tar.gz"
    destination = "/tmp/"
  }

  # bastion init script (install software, configure the system)
  provisioner "shell" {
    execute_command = "chmod +x {{ .Path }}; sudo env {{ .Vars }} sh '{{ .Path }}'"
    scripts         = ["${path.root}/commands.sh"]
    env             = {
      "RELEASES_KEY" = "${var.releases_key}"
    }
  }

  # copy SW report
  provisioner "file" {
    direction   = "download"
    destination = "${path.root}/sw_report.md"
    source      = "/var/log/packer/sw_report.md"
  }

  # propagate version into the image
  provisioner "shell" {
    execute_command = "chmod +x {{ .Path }}; sudo env {{ .Vars }} sh '{{ .Path }}'"
    inline = [
      "echo 'export BASTION_VERSION=\"${var.version}\"' > /etc/profile.d/bastion_version.sh"
    ]
  }

  # VM cleanup
  provisioner "shell" {
    execute_command = "chmod +x {{ .Path }}; sudo env {{ .Vars }} sh '{{ .Path }}'"
    inline = [
      "[ -e /usr/sbin/waagent ] && /usr/sbin/waagent -force -deprovision+user && export HISTSIZE=0 && sync"
    ]
  }
}